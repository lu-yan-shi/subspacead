# ============================================================
# SubspaceAD Dockerfile
# ============================================================
# 构建（默认 CUDA，支持 GPU/CPU 自动切换）:
#   docker build -t subspacead .
#
# 运行:
#   GPU: docker run --gpus all -p 8704:8704 subspacead
#   CPU: docker run -p 8704:8704 subspacead
# ============================================================

FROM pytorch/pytorch:2.6.0-cuda12.6-cudnn9-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# 提前拷贝模型下载器 + Token，构建时预下载
COPY models/model_downloader.py ./models/model_downloader.py
COPY ModelScope_token ./ModelScope_token
RUN mkdir -p /app/weights && \
    python -c "from models.model_downloader import ensure_weights; ensure_weights()"

# 其余代码（改代码只重建这一层，不重下载模型）
COPY . .

EXPOSE 8704

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8704"]
